# ─────────────────────────────────────────────────────────────────────────────
#  Cadence Studio — environment variables
#  Copy this file to `.env.local` and fill in your key.
#  Nothing here costs money: the Gemini free tier needs no credit card.
# ─────────────────────────────────────────────────────────────────────────────

# 1) Get a free key: https://aistudio.google.com/apikey  (Google account only)
GEMINI_API_KEY=

# 2) Optional overrides -------------------------------------------------------
# Model used for chat + viral clipping. gemini-2.5-flash is free-tier friendly
# and has a 1M token context window, so a whole transcript fits easily.
GEMINI_MODEL=gemini-2.5-flash

# Fallback model if the primary one is rate-limited / overloaded.
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite

# Optional: route transcript scraping through a proxy (useful if your host's
# IP range is rate-limited by YouTube, e.g. some serverless platforms).
# TRANSCRIPT_PROXY_URL=

# Optional: force demo mode (always serve the bundled sample transcript).
# CADENCE_DEMO_MODE=1
