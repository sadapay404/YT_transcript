# ─────────────────────────────────────────────────────────────────────────────
#  TranStudio — environment variables
#  Copy this file to `.env.local` and fill in your key.
#  Nothing here costs money: the Gemini free tier needs no credit card.
# ─────────────────────────────────────────────────────────────────────────────

# 1) Get a free key: https://aistudio.google.com/apikey  (Google account only)
GEMINI_API_KEY=

# 2) Optional backup AI: Groq (free plan, no credit card, very fast).
#    NexAI uses Gemini first and switches to Groq automatically if Gemini is
#    busy or out of free quota. Readers can also pick Groq in the NexAI menu.
#    Key: https://console.groq.com/keys
GROQ_API_KEY=

# 3) Optional overrides -------------------------------------------------------
# Leave these unset: the app asks Google which models your key can use and
# picks the best free Flash / Flash-Lite automatically. Only pin a model if you
# have a reason to — a pin your key can't use is skipped, never fatal.
# GEMINI_MODEL=
# GEMINI_FALLBACK_MODEL=

# Optional: route transcript scraping through a proxy (useful if your host's
# IP range is rate-limited by YouTube, e.g. some serverless platforms).
# TRANSCRIPT_PROXY_URL=

# Optional: force demo mode (always serve the bundled sample transcript).
# TRANSTUDIO_DEMO_MODE=1
