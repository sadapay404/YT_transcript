{
  "name": "transtudio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "desktop:prepare": "node scripts/prepare-electron.mjs",
    "desktop:dev": "npm run build && npm run desktop:prepare && electron .",
    "desktop:dir": "npm run build && npm run desktop:prepare && electron-builder --dir",
    "desktop:build": "npm run build && npm run desktop:prepare && electron-builder --win"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@fontsource/opendyslexic": "^5.3.0",
    "@google/genai": "^2.24.0",
    "clsx": "^2.1.1",
    "framer-motion": "^13.4.3",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.7.0",
    "youtube-transcript": "^1.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^37.10.3",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.1"
  },
  "description": "TranStudio — read any YouTube video: synchronized transcripts, readable exports, free-tier AI.",
  "engines": {
    "node": "22.x"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.transtudio.desktop",
    "productName": "TranStudio",
    "artifactName": "TranStudio-Setup-${version}.${ext}",
    "asar": true,
    "asarUnpack": [
      ".next/standalone/**"
    ],
    "files": [
      "electron/**",
      ".next/standalone/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/app/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TranStudio",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "electronFuses": {
      "runAsNode": true
    }
  }
}
